# Copie para .env e ajuste. Nunca faça commit do .env.
# Segredo do JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=
PORT=3000
DATABASE_FILE=./data/abyssal.db
# 1 = confiar no X-Forwarded-For (use atrás de Railway/Render/Nginx)
TRUST_PROXY=0
# Origens extras permitidas (cliente hospedado em outro domínio), separadas por vírgula
ALLOWED_ORIGINS=
# 1 = cookie SameSite=None; Secure (cliente e servidor em domínios diferentes)
CROSS_SITE_COOKIES=0
