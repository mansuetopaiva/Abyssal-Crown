{
  "name": "abyssal-crown",
  "version": "1.0.0",
  "private": true,
  "description": "Abyssal Crown — dungeon crawler multiplayer para navegador",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "npm run build:client && tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "esbuild client/src/main.ts --bundle --minify --sourcemap --target=es2020 --outfile=client/dist/game.js",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start": "node --no-warnings=ExperimentalWarning dist/server.js",
    "seed": "tsx server/seed.ts",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": ">=0.165.0 <1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
